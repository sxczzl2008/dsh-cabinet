{
  "name": "dsh-cabinet",
  "version": "0.6.2",
  "description": "DeepSeek Harness 多模型内阁协作插件：五大预设模式、平行盲写与一对一盲审、思考档位拉杆、右侧齿轮翻转标签、分片施工硬工具围栏与双层三次熔断保护。",
  "license": "MIT",
  "author": "Helios <sxczzl2008@gmail.com>",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cabinet",
    "multi-agent",
    "multi-model",
    "orchestrator",
    "workflow",
    "dashboard",
    "code-review",
    "agent-team"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.0"
  },
  "scripts": {
    "check": "node --check lib/index.js",
    "install-plugin": "node scripts/patch-host.cjs --install",
    "uninstall-plugin": "node scripts/patch-host.cjs --uninstall"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxczzl2008/dsh-cabinet.git"
  },
  "homepage": "https://github.com/sxczzl2008/dsh-cabinet#readme",
  "bugs": {
    "url": "https://github.com/sxczzl2008/dsh-cabinet/issues"
  }
}
